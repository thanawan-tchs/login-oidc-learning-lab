{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "clients": [
    {
      "clientId": "demo-op-admin",
      "name": "OIDC provider -> Keycloak Admin API client",
      "description": "Our hand-rolled OP authenticates users itself (mobile + OTP) and only reaches Keycloak over the Admin REST API, as a service account, to find-or-create the matching user record. Keycloak never runs an OIDC login for end users in this setup.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "op-admin-secret-dev",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-demo-op-admin",
      "enabled": true,
      "serviceAccountClientId": "demo-op-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ]
}
