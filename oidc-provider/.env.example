# Copy to .env.local (gitignored). Next.js loads it automatically.

OP_ISSUER=http://localhost:4000

KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=demo
# Service-account client for the Admin API (find-or-create user by phone).
# Must match the "demo-op-admin" client secret in docker/keycloak/realm-export.json
KEYCLOAK_ADMIN_CLIENT_ID=demo-op-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=op-admin-secret-dev

# The "demo-rp" client's secret in this OP's own client registry (lib/config.js).
# Must match CLIENT_SECRET in rp-backend/.env.
DEMO_RP_CLIENT_SECRET=rp-secret-dev

REDIS_URL=redis://localhost:6379
