# Copy to .env (gitignored). Loaded via `node --env-file-if-exists=.env`.

PORT=4001
OP_ISSUER=http://localhost:4000

# This client is registered in oidc-provider/lib/config.js — must match
# DEMO_RP_CLIENT_SECRET in oidc-provider/.env.local.
CLIENT_ID=demo-rp
CLIENT_SECRET=rp-secret-dev
REDIRECT_URI=http://localhost:4001/callback

FRONTEND_ORIGIN=http://localhost:5173
POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

REDIS_URL=redis://localhost:6379
